{{> header title=title}}

<div class="content">
    <h2>{{title}}</h2>
    
    <p>{{message}}</p>
    
    {{#if actionUrl}}
    <div style="text-align: center; margin: 30px 0;">
        <a href="{{actionUrl}}" class="button">{{#if actionText}}{{actionText}}{{else}}Take Action{{/if}}</a>
    </div>
    {{/if}}
    
    <div class="highlight">
        <strong>This is an automated notification from ELM AI Task.</strong><br>
        You're receiving this because of activity related to your account or tasks you're involved with.
    </div>
    
    <p>If you have any questions about this notification, please contact our support team.</p>
    
    <p>Best regards,<br>
    The ELM AI Task Team</p>
</div>

{{> footer currentDate=(new Date) unsubscribeUrl=unsubscribeUrl}}