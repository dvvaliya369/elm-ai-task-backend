# Example .env file for Redis High-Performance Setup

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0

# Alternative: Redis connection URL (if using cloud Redis)
# REDIS_URL=redis://username:password@redis-host:6379/0
# REDIS_TLS_URL=rediss://username:password@redis-host:6380/0

# Database Configuration
DB_CONNECTION_STRING=mongodb://localhost:27017/your_database_name
# or for SQL databases:
# DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/database_name

# Application Settings  
NODE_ENV=production
PORT=3000

# JWT Configuration (if using authentication)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com

# Performance Tuning
REDIS_POOL_SIZE=10
LIKE_RATE_LIMIT_WINDOW=60
MAX_LIKES_PER_USER_PER_MINUTE=10
DATABASE_SYNC_INTERVAL=5000
QUEUE_BATCH_SIZE=100

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_INTERVAL=10000

# Optional: Cloud Storage (Google Cloud, AWS S3, etc.)
# GOOGLE_CLOUD_PROJECT_ID=your-project-id
# GOOGLE_CLOUD_KEY_FILE=path/to/service-account.json
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
