# Example Environment Configuration (.env.example)

# Application Configuration
API_URL=http://localhost:8000
PORT=8000
DOMAIN=localhost

# JWT Configuration
JWT_SECRET_AUTH=your_jwt_secret_key_here
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRY=7d

# Database Configuration
DB_URL=mongodb://localhost:27017/elm-ai-task

# Google Cloud Storage Configuration
GCS_PROJECT_ID=your-gcs-project-id
GCS_BUCKET_NAME=your-bucket-name

# Redis Configuration Options

## Option 1: Local Redis Instance
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_ENABLE_TLS=false
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=5000

## Option 2: Redis Cloud/Remote Instance (comment out Option 1 if using this)
# REDIS_URL=rediss://default:password@hostname:port/database
# REDIS_ENABLE_TLS=true
# REDIS_MAX_RETRIES=5
# REDIS_RETRY_DELAY_MS=3000

## Option 3: AWS ElastiCache (comment out other options if using this)
# REDIS_URL=rediss://your-cluster.cache.amazonaws.com:6380
# REDIS_ENABLE_TLS=true
# REDIS_MAX_RETRIES=3
# REDIS_RETRY_DELAY_MS=5000
